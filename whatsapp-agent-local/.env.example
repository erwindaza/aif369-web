# PostgreSQL local (agent01). Genera PGPASSWORD en el setup, nunca lo subas a Git.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=whatsapp_agent
PGUSER=wa_agent
PGPASSWORD=

# Ollama local (agent01)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_KEEP_ALIVE=-1
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_PREDICT=110
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_MS=12000

# Comportamiento
DATA_DIR=./data
HEALTH_PORT=8090
ALLOW_GROUPS=false
CONTEXT_MESSAGES=8
REPLY_DELAY_MIN_MS=120
REPLY_DELAY_MAX_MS=450
INSTANT_REPLY_DELAY_MIN_MS=120
INSTANT_REPLY_DELAY_MAX_MS=400

# Capa de conocimiento (retrieval antes de llamar al LLM)
KNOWLEDGE_DIR=./knowledge
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MAX_CHARS=2200
# lexical (default, ~1-4ms) | embedding (usa OLLAMA con nomic-embed-text)
KNOWLEDGE_RETRIEVER=lexical
KNOWLEDGE_EMBED_MODEL=nomic-embed-text
