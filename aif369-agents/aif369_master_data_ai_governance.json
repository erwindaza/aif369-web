        ]
      },
      {
        "month": 8,
        "title": "Diagramación profesional y Architecture as Code",
        "tools": [
          "Draw.io",
          "Lucidchart",
          "Lucidscale",
          "Mermaid",
          "PlantUML",
          "Structurizr",
          "Miro"
        ],
        "modules": [
          "Convenciones visuales y storytelling arquitectónico",
          "Diagramas editables y reutilizables",
          "Iconografía cloud oficial",
          "Diagramas declarativos en Git",
          "Automatización de documentación",
          "Versionado, revisión y publicación",
