          "Roadmap de mejora"
        ],
        "deliverables": [
          "Assessment DCAM simulado",
          "Heatmap de madurez",
          "Roadmap de 24 meses"
        ]
      },
      {
        "month": 10,
        "title": "Gobierno avanzado de IA y regulación",
        "frameworks": [
          "NIST AI RMF",
          "EU AI Act",
          "OECD AI Principles",
          "UNESCO AI Ethics"
        ],
        "modules": [
          "Map, Measure, Manage y Govern",
