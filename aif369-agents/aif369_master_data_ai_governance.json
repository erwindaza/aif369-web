  "curriculum": {
    "structure": "12 meses, 4 trimestres, proyecto integrador incremental",
    "months": [
      {
        "month": 1,
        "title": "Fundamentos de arquitectura empresarial y estrategia",
        "certification_alignment": [
          "TOGAF Enterprise Architecture Foundation"
        ],
        "modules": [
          "Rol del Enterprise Data & AI Architect",
          "Estrategia, operating model y capacidades empresariales",
          "Principios de arquitectura",
          "Architecture Repository y gobernanza de decisiones",
          "Introducción a TOGAF ADM"
        ],
        "deliverables": [
          "Mapa de capacidades",
          "Principios de arquitectura",
          "Visión de arquitectura"
        ]
      },
      {
        "month": 2,
        "title": "TOGAF aplicado a datos e IA",
        "certification_alignment": [
          "TOGAF Enterprise Architecture Foundation",
          "TOGAF Enterprise Architecture Practitioner"
        ],
        "modules": [
          "ADM aplicado a transformación Data & AI",
          "Arquitectura de negocio, datos, aplicaciones y tecnología",
          "Requirements Management",
          "Architecture Governance",
          "Roadmaps, plateaus y transition architectures",
          "Preparación orientativa para certificación TOGAF"
        ],
        "deliverables": [
          "Architecture Definition Document",
          "Roadmap de transición",
          "Matriz de stakeholders"
        ]
      },
      {
        "month": 3,
        "title": "DAMA-DMBOK, gobierno y gestión de datos",
        "certification_alignment": [
          "CDMP Associate"
        ],
        "modules": [
          "Data Governance",
          "Data Architecture",
          "Data Modeling and Design",
          "Data Storage and Operations",
          "Data Security",
          "Data Integration and Interoperability",
          "Document and Content Management",
          "Reference and Master Data",
          "Data Warehousing and Business Intelligence",
          "Metadata Management",
          "Data Quality"
        ],
        "deliverables": [
          "Data Governance Operating Model",
          "RACI de datos",
          "Glosario empresarial",
          "Plan de calidad de datos"
        ]
      },
      {
        "month": 4,
        "title": "ISO/IEC 27001 y gestión de seguridad",
        "certification_alignment": [
          "ISO/IEC 27001 Foundation",
          "ISO/IEC 27001 Lead Implementer - preparación"
        ],
        "modules": [
          "Contexto, alcance y partes interesadas",
          "Liderazgo, planificación y evaluación de riesgos",
          "SoA y tratamiento de riesgos",
          "Operación, auditoría interna y mejora continua",
          "Controles de seguridad aplicados a datos e IA",
          "Threat Modeling y DevSecOps"
        ],
        "deliverables": [
          "Alcance de SGSI",
          "Risk Register",
          "Statement of Applicability",
          "Plan de tratamiento"
        ]
      },
      {
        "month": 5,
        "title": "ISO/IEC 27701, privacidad y derechos de titulares",
        "certification_alignment": [
          "ISO/IEC 27701 Foundation",
          "Privacy Information Management"
        ],
        "modules": [
          "Sistema de gestión de información de privacidad",
          "Roles de responsable y encargado del tratamiento",
          "Inventario de tratamientos y flujo de datos personales",
          "Privacy by Design y Privacy by Default",
          "DPIA y evaluación de riesgos de privacidad",
          "Retención, eliminación, anonimización y seudonimización",
          "Transferencias internacionales y proveedores",
          "Gestión de incidentes y brechas de datos"
        ],
        "rights_of_data_subjects": [
          "Derecho de acceso",
          "Derecho de rectificación",
          "Derecho de supresión o cancelación, según la jurisdicción",
          "Derecho de oposición",
          "Derecho de portabilidad",
          "Derecho de bloqueo, cuando corresponda",
          "Derecho a información y transparencia",
          "Derechos frente a decisiones automatizadas y elaboración de perfiles, cuando correspondan",
          "Canales, identidad, plazos, evidencias, excepciones y trazabilidad de solicitudes"
        ],
        "deliverables": [
          "RoPA o registro de tratamientos",
          "DPIA",
          "Flujo de atención de derechos",
          "Matriz de retención"
        ]
      },
      {
        "month": 6,
        "title": "ISO/IEC 42001 y sistema de gestión de IA",
        "certification_alignment": [
          "ISO/IEC 42001 Foundation",
          "ISO/IEC 42001 Lead Implementer - preparación"
        ],
        "modules": [
          "Contexto, alcance y política de IA",
          "Inventario y clasificación de sistemas de IA",
          "Evaluación de impacto y riesgos de IA",
          "Objetivos, controles y responsabilidades",
          "Gestión del ciclo de vida de IA",
          "Gestión de datos, modelos, proveedores y terceros",
          "Supervisión humana y comunicación",
          "Monitoreo, auditoría y mejora"
        ],
        "deliverables": [
          "AI Management System Scope",
          "AI Inventory",
          "AI Risk Register",
          "AI Impact Assessment",
          "AI Policy"
        ]
      },
      {
        "month": 7,
        "title": "ArchiMate, C4, ADR y modelado arquitectónico",
        "modules": [
          "ArchiMate: estrategia, negocio, aplicaciones, tecnología, implementación y motivación",
